# LibriFree Environment Configuration
# Copy this file to .env and update with your values

# JWT Configuration
# This key will be generated automatically by setup.bat
# For manual setup, generate a secure random key (at least 32 characters)
JWT_SECRET_KEY=your-secret-key-here-replace-with-secure-random-value

# Database Configuration
DATABASE_PATH=/app/data/librifree.db

# ASP.NET Core Configuration
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5051

# Note: The setup.bat script will automatically generate a secure JWT_SECRET_KEY
# and create a .env file from this template
